# --- Project-specific ignores ---

# --- Python Virtual Environments ---
# These folders contain your local Python setup and should not be shared.
/venv/
/.venv/
/env/
/.env/
/env.bak/
/venv.bak/

# --- Python Cache Files ---
# Python generates these temporary files; they are not part of your source code.
__pycache__/
*.pyc
*.pyo
*.pyd

# --- IDE / Editor Specific Files ---
# These are your personal settings for your code editor (like VS Code).
.vscode/
.idea/

# --- Jupyter Notebook Checkpoints ---
# Jupyter creates this folder automatically for auto-saves.
.ipynb_checkpoints/

# --- Operating System Files ---
# Ignores system files generated by macOS, Windows, and Linux.
.DS_Store
Thumbs.db
desktop.ini

# --- Large Data Files ---
# CRITICAL: It is a best practice to NEVER commit large data files to Git.
# Your repository would become too large and slow.
/data/
/data_cleaned/

# --- Generated Visualizations (Optional) ---
# For this project, you WANT your visualizations to be on GitHub so they appear
# in your report. Therefore, we will NOT ignore this folder.
# If you didn't want them tracked, you would uncomment the line below:
# /visualizations/